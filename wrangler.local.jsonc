// Config solo para `npm run preview`. Es igual a wrangler.jsonc pero sin `routes`:
// con routes, `wrangler dev` reescribe cada petición al primer dominio
// (humanoydev.com) y el Worker no puede ver jean.localhost.
// Si cambias wrangler.jsonc, replica aquí lo que no sean las routes.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "humanoydev",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "404-page"
  },
  // Base de datos del baby shower (invitados, visitas y respuestas). Ver worker/babyshower.ts.
  "d1_databases": [{ "binding": "DB", "database_name": "jeanpaulandre", "migrations_dir": "migrations" }],
  // Cloudflare Access del panel /admin (no son secretos). Vacías, la API de admin se niega
  // en producción. Ejemplo: "https://<equipo>.cloudflareaccess.com" y el "Application Audience (AUD) Tag".
  "vars": { "ACCESS_TEAM_DOMAIN": "", "ACCESS_AUD": "" },
  // Aviso por correo de cada respuesta (worker/babyshower.ts, notifyRsvp). Las direcciones
  // van en el secreto NOTIFY_TO y deben estar verificadas en Email Routing de humanoydev.com.
  "send_email": [{ "name": "NOTIFY_EMAIL" }]
}
