# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# cloudflare
.wrangler/
.dev.vars*

# claude code (configuración personal)
.claude/settings.local.json

# Ecografía de Jean Paul André: el repo es público. Se despliega desde la copia local
# (npm run deploy sube ./out), pero no se sube a GitHub.
/public/jeanpaulandre/videos/
/public/jeanpaulandre/images/ecografia-*
